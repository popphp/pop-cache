{
    "name": "popphp/pop-cache",
    "description": "Pop Cache Component for Pop PHP Framework",
    "keywords": [
        "cache",
        "caching",
        "redis",
        "memcache",
        "apc",
        "php",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/pop-cache",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/pop-db": "^7.0.0-beta.1",
        "psr/simple-cache": "^3.0",
        "psr/cache": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "Pop\\Cache\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Cache\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        }
    }
}
